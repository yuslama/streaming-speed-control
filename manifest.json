{
  "manifest_version": 3,
  "name": "Streaming Speed Control",
  "short_name": "Stream Speed",
  "version": "1.1.0",
  "description": "Playback speed control for HBO Max, Netflix, Hulu, Prime Video, Disney+, Paramount+ and Peacock. Any speed from 0.25x to 4x.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.hbomax.com/*",
    "https://*.max.com/*",
    "https://*.netflix.com/*",
    "https://*.hulu.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/gp/video/*",
    "https://*.amazon.co.uk/gp/video/*",
    "https://*.amazon.de/gp/video/*",
    "https://*.amazon.co.jp/gp/video/*",
    "https://*.amazon.ca/gp/video/*",
    "https://*.amazon.com.au/gp/video/*",
    "https://*.amazon.in/gp/video/*",
    "https://*.amazon.fr/gp/video/*",
    "https://*.amazon.it/gp/video/*",
    "https://*.amazon.es/gp/video/*",
    "https://*.amazon.com.mx/gp/video/*",
    "https://*.amazon.com.br/gp/video/*",
    "https://*.amazon.nl/gp/video/*",
    "https://*.disneyplus.com/*",
    "https://*.paramountplus.com/*",
    "https://*.peacocktv.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Streaming Speed Control",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hbomax.com/*",
        "https://*.max.com/*",
        "https://*.netflix.com/*",
        "https://*.hulu.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://*.amazon.co.uk/gp/video/*",
        "https://*.amazon.de/gp/video/*",
        "https://*.amazon.co.jp/gp/video/*",
        "https://*.amazon.ca/gp/video/*",
        "https://*.amazon.com.au/gp/video/*",
        "https://*.amazon.in/gp/video/*",
        "https://*.amazon.fr/gp/video/*",
        "https://*.amazon.it/gp/video/*",
        "https://*.amazon.es/gp/video/*",
        "https://*.amazon.com.mx/gp/video/*",
        "https://*.amazon.com.br/gp/video/*",
        "https://*.amazon.nl/gp/video/*",
        "https://*.disneyplus.com/*",
        "https://*.paramountplus.com/*",
        "https://*.peacocktv.com/*"
      ],
      "js": [
        "src/shared/speed-utils.js",
        "src/content/video-controller.js",
        "src/content/overlay-ui.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
